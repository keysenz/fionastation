DATABASE_PATH=/path/to/karaoke.db
# The site owns this file and is its only writer. Keep it on a volume the site can write.
PLAYLISTS_DB_PATH=/path/to/playlists.db
# Optional. Creates per visitor IP per hour. Defaults to 10.
# PLAYLISTS_IP_LIMIT_PER_HOUR=10
# Optional. Starts the admin listener on ADMIN_PORT (default 3001) for the Discord bot.
# ADMIN_SECRET=
# ADMIN_PORT=3001
# Optional. Discord login for playlist owners. The site reuses the bot's Discord application.
# Without both values every /api/auth route answers 503.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Optional. The public origin of the site. Login redirects back to it, and a write that
# authenticates with the session cookie must come from it.
# SITE_ORIGIN=https://fionastation.vercel.app
# Optional. Tests point this at .claude/skills/verify/fake-discord.mjs.
# DISCORD_API_BASE=https://discord.com/api
