DATABASE_PATH=/path/to/karaoke.db
# The site owns this file and is its only writer. Keep it on a volume the site can write.
PLAYLISTS_DB_PATH=/path/to/playlists.db
# Optional. Creates per visitor IP per hour. Defaults to 10.
# PLAYLISTS_IP_LIMIT_PER_HOUR=10
# Optional. The site owns this file and is its only writer. Without it, play statistics are off.
# STATS_DB_PATH=/path/to/stats.db
# Optional. Comma-separated Discord user ids that may open /stats. Needs STATS_DB_PATH and Discord
# login. Without it the page's data route answers 503.
# STATS_USER_IDS=244661517356761089,927090060480905276
# Optional. Statistic posts per visitor IP per hour. Defaults to 600.
# STATS_IP_LIMIT_PER_HOUR=600
# Optional. Days to keep the anonymous listening trail and autoplay decisions (the per-visit rows
# in STATS_DB_PATH). Older rows are deleted at startup and once a day. Daily totals are kept.
# Defaults to 180.
# STATS_TRAIL_DAYS=180
# Optional. The site owns this file and is its only writer. It holds commission inquiries and their
# status history. Without it, POST /api/inquiry answers 503 and the forms cannot send.
# COMMISSIONS_DB_PATH=/path/to/commissions.db
# Required with COMMISSIONS_DB_PATH. Keys the tracking links (HMAC-SHA256 of the inquiry id) and the
# stored IP hash. Changing it breaks every tracking link already sent. Use 32 random bytes.
# COMMISSIONS_SECRET=
# Optional. New inquiries per visitor IP per hour. Defaults to 5.
# COMMISSIONS_IP_LIMIT_PER_HOUR=5
# Optional. Starts the admin listener on ADMIN_PORT (default 3001) for the Discord bot. It serves
# /admin/playlists and /admin/commissions, whichever stores exist.
# ADMIN_SECRET=
# ADMIN_PORT=3001
# Optional. Discord login for playlist owners. The site reuses the bot's Discord application.
# Without both values every /api/auth route answers 503.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Optional. The public origin of the site. Login redirects back to it, and a write that
# authenticates with the session cookie must come from it.
# SITE_ORIGIN=https://fionastation.vercel.app
# Optional. Tests point this at .claude/skills/verify/fake-discord.mjs.
# DISCORD_API_BASE=https://discord.com/api
