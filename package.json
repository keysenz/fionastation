{
  "name": "fionastation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/main.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "effect": "4.1.0",
    "foldkit": "0.170.0",
    "fuse.js": "^7.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "^26",
    "autoprefixer": "^10.4.16",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
