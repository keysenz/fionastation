 "lines": [
  {
   "atMs": 1040,
   "text": "空にある何かを見つめてたら"
  },
  {
   "atMs": 6220,
   "text": "それは星だって君がおしえてくれた"
  },
  {
   "atMs": 11870,
   "text": "まるでそれは僕らみたいに 寄り添ってる"
  },
  {
   "atMs": 17010,
   "text": "それを泣いたり笑ったり繋いでいく"
  },
  {
   "atMs": 22750,
   "text": "何十回 何百回 ぶつかりあって"
  },
  {
   "atMs": 28180,
   "text": "何十年 何百年 昔の光が"
  },
  {
   "atMs": 33440,
   "text": "星自身も忘れたころに"
  },
  {
   "atMs": 38490,
   "text": "僕らに届いてる"
  },
  {
   "atMs": 43250,
   "text": "僕ら見つけあって 手繰りあって 同じ空"
  },
  {
   "atMs": 48460,
   "text": "輝くのだって 二人だって 約束した"
  },
  {
   "atMs": 53710,
   "text": "遥か遠く終わらないべテルギウス"
  },
  {
   "atMs": 59180,
   "text": "誰かに繋ぐ魔法"
  },
  {
   "atMs": 64570,
   "text": "僕ら 肩並べ 手取り合って 進んでく"
  },
  {
   "atMs": 69800,
   "text": "辛い時だって 泣かないって 誓っただろう"
  },
  {
   "atMs": 75110,
   "text": "遥か遠く終わらないべテルギウス"
  },
  {
   "atMs": 80400,
   "text": "君にも見えるだろう 祈りが"
  },
  {
   "atMs": 89120,
   "text": "記憶を辿るたび 蘇るよ"
  },
  {
   "atMs": 94390,
   "text": "君がいつだってそこに居てくれること"
  },
  {
   "atMs": 99760,
   "text": "まるでそれは星の光と 同じように"
  },
  {
   "atMs": 105020,
   "text": "今日に泣いたり笑ったり繋いでいく"
  },
  {
   "atMs": 110730,
   "text": "何十回 何百回 ぶつかりあって"
  },
  {
   "atMs": 116150,
   "text": "何十年 何百年 昔の光が"
  },
  {
   "atMs": 121300,
   "text": "僕自身も忘れたころに"
  },
  {
   "atMs": 126410,
   "text": "僕らを照らしてる"
  },
  {
   "atMs": 131340,
   "text": "僕ら見つけあって 手繰りあって 同じ空"
  },
  {
   "atMs": 136400,
