  },
  {
   "atMs": 141650,
   "text": "遥か遠く終わらないべテルギウス"
  },
  {
   "atMs": 147120,
   "text": "誰かに繋ぐ魔法"
  },
  {
   "atMs": 152970,
   "text": "どこまで いつまで 生きられるか"
  },
  {
   "atMs": 158310,
   "text": "君が不安になるたびに強がるんだ"
  },
  {
   "atMs": 162930,
   "text": "大丈夫 僕が横にいるよ"
  },
  {
   "atMs": 168320,
   "text": "見えない線を繋ごう"
  },
