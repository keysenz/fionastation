{
 "lines": [
  {
   "atMs": 32130,
   "text": "君とのラブストーリー"
  },
  {
   "atMs": 35430,
   "text": "それは予想通り"
  },
  {
   "atMs": 38240,
   "text": "いざ始まればひとり芝居だ"
  },
  {
   "atMs": 42370,
   "text": "ずっとそばにいたって"
  },
  {
   "atMs": 44850,
   "text": "結局ただの観客だ"
  },
  {
   "atMs": 47890,
   "text": "感情のないアイムソーリー"
  },
  {
   "atMs": 51080,
   "text": "それはいつも通り"
  },
  {
   "atMs": 53630,
   "text": "慣れてしまえば悪くはないけど"
  },
  {
   "atMs": 57860,
   "text": "君とのロマンスは人生柄"
  },
  {
   "atMs": 61600,
   "text": "続きはしないことを知った"
  },
  {
   "atMs": 68470,
   "text": "もっと違う設定で もっと違う関係で"
  },
  {
   "atMs": 73580,
   "text": "出会える世界線 選べたらよかった"
  },
  {
   "atMs": 78810,
   "text": "もっと違う性格で もっと違う価値観で"
  },
  {
   "atMs": 84070,
   "text": "愛を伝えられたらいいな そう願っても無駄だから"
  },
  {
   "atMs": 93900,
   "text": "グッバイ"
  },
  {
   "atMs": 95050,
   "text": "君の運命のヒトは僕じゃない"
  },
  {
   "atMs": 99640,
   "text": "辛いけど否めない でも離れ難いのさ"
  },
  {
   "atMs": 105850,
   "text": "その髪に触れただけで 痛いや"
  },
  {
   "atMs": 111270,
   "text": "いやでも 甘いな いやいや"
  },
  {
   "atMs": 114770,
   "text": "グッバイ"
  },
  {
   "atMs": 115540,
   "text": "それじゃ僕にとって君は何？"
  },
  {
   "atMs": 120370,
   "text": "答えは分からない 分かりたくもないのさ"
  },
  {
   "atMs": 126670,
   "text": "たったひとつ確かなことがあるとするのならば"
  },
  {
   "atMs": 134780,
   "text": "「君は綺麗だ」"
  },
  {
   "atMs": 139420,
   "text": ""
  },
  {
   "atMs": 141930,
   "text": "誰かが偉そうに"
  },
  {
   "atMs": 144830,
   "text": "語る恋愛の論理"
  },
  {
   "atMs": 147580,
   "text": "何ひとつとしてピンとこなくて"
  },
  {
   "atMs": 151760,
   "text": "飛行機の窓から見下ろした"
  },
  {
   "atMs": 155430,
   "text": "知らない街の夜景みたいだ"
  },
  {
   "atMs": 162380,
   "text": "もっと違う設定で もっと違う関係で"
  },
  {
   "atMs": 167320,
   "text": "出会える世界線 選べたらよかった"
  },
  {
   "atMs": 172760,
   "text": "いたって純な心で 叶った恋を抱きしめて"
  },
  {
   "atMs": 177700,
   "text": "「好きだ」とか無責任に言えたらいいな"
  },
  {
   "atMs": 182470,
   "text": "そう願っても虚しいのさ"
  },
  {
   "atMs": 187930,
   "text": "グッバイ"
  },
  {
   "atMs": 188660,
   "text": "繋いだ手の向こうにエンドライン"
  },
  {
   "atMs": 193560,
   "text": "引き伸ばすたびに 疼きだす未来には"
  },
  {
   "atMs": 199710,
   "text": "君はいない その事実に Cry..."
  },
  {
   "atMs": 207490,
   "text": "そりゃ苦しいよな"
  },
  {
   "atMs": 211060,
   "text": ""
  },
  {
   "atMs": 229630,
   "text": "グッバイ"
  },
  {
   "atMs": 230520,
   "text": "君の運命のヒトは僕じゃない"
  },
  {
   "atMs": 235270,
   "text": "辛いけど否めない でも離れ難いのさ"
  },
  {
   "atMs": 241620,
   "text": "その髪に触れただけで 痛いや"
  },
  {
   "atMs": 246730,
   "text": "いやでも 甘いな いやいや"
  },
  {
   "atMs": 250440,
   "text": "グッバイ"
  },
  {
   "atMs": 251330,
   "text": "それじゃ僕にとって君は何？"
  },
  {
   "atMs": 256090,
   "text": "答えは分からない 分かりたくもないのさ"
  },
  {
   "atMs": 262500,
   "text": "たったひとつ確かなことがあるとするのならば"
  },
  {
   "atMs": 270390,
   "text": "「君は綺麗だ」"
  },
  {
   "atMs": 272660,
   "text": "それもこれもロマンスの定めなら 悪くないよな"
  },
  {
   "atMs": 282960,
   "text": "永遠も約束もないけれど"
  },
  {
   "atMs": 291040,
   "text": "「とても綺麗だ」"
  },
  {
   "atMs": 292530,
   "text": ""
  }
 ],
