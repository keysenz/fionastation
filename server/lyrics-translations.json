      {
        "atMs": 21538,
        "text": "Di tempat penuh rasa kelam,"
      },
      {
        "atMs": 25676,
        "text": "aku merasa terasingkan."
      },
      {
        "atMs": 29813,
        "text": "Terjebak dalam dunia penuh sihir,"
      },
      {
        "atMs": 34118,
        "text": "aku pun bertemu sang takdir."
      },
      {
        "atMs": 38122,
        "text": "“Di manakah aku?\""
      },
      {
        "atMs": 40224,
        "text": "\"Siapa pun tolong aku!”"
      },
      {
        "atMs": 42393,
        "text": "Itulah gumamku"
      },
      {
        "atMs": 44728,
        "text": "saat merasa sepi."
      },
      {
        "atMs": 46797,
        "text": "Purnama pun menyinari sang gulita,"
      },
      {
        "atMs": 50801,
        "text": "memberikan ketenangan lewat binarnya."
      },
      {
        "atMs": 55039,
        "text": "Jiwa yang terjebak dalam dimensi penuh mimpi,"
      },
      {
        "atMs": 59009,
        "text": "buatku bingung akan kehadiranku ini."
      },
      {
        "atMs": 63313,
        "text": "Seseorang pun datang merapalkan mantra,"
