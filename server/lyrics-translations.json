  "2ef12473-c128-5136-b54b-dcc1a8d6b5e2": {
    "language": "en",
    "lines": [
      {
        "atMs": 3250,
        "text": "Tak ada seorang pun di ruangan yang terbuka ini"
      },
      {
        "atMs": 13087,
        "text": ""
      },
      {
        "atMs": 13731,
        "text": "Hanya ada sebuah kursi yang beraroma angin laut"
      },
      {
        "atMs": 22787,
        "text": ""
      },
      {
        "atMs": 23298,
        "text": "Aku membiarkannya terbuka agar kau tak tersesat"
      },
      {
        "atMs": 27308,
        "text": "Sementara membuat suara decitan"
      },
      {
        "atMs": 33156,
        "text": ""
      },
      {
        "atMs": 33632,
        "text": "Apakah yang sebaiknya kubicarakan?"
      },
      {
        "atMs": 38133,
        "text": "Mungkinkah aku kehilangan arah?"
      },
      {
        "atMs": 43706,
        "text": ""
      },
      {
        "atMs": 46648,
        "text": "Seperti hujan bintang, aku ingin bertemu denganmu"
      },
      {
        "atMs": 52502,
        "text": ""
      },
      {
        "atMs": 52597,
        "text": "Aku takkan pernah melupakan malam itu"
      },
      {
        "atMs": 56929,
        "text": ""
      },
      {
        "atMs": 57131,
        "text": "Hal yang berharga tak dapat menjadi kata-kata"
      },
      {
        "atMs": 62791,
        "text": ""
      },
      {
        "atMs": 62933,
        "text": "Segalanya yang terjadi di musim panas"
      },
      {
        "atMs": 67423,
        "text": ""
      },
      {
        "atMs": 68543,
        "text": "Cahaya yang tanpa diduga itu"
      },
      {
        "atMs": 74071,
        "text": "Adalah roh laut"
      },
      {
        "atMs": 78239,
        "text": ""
      },
      {
        "atMs": 91354,
        "text": "Bagaikan puncak bukit yang melihat kepergian kapal saat musim panas"
      },
      {
        "atMs": 101419,
        "text": ""
      },
      {
        "atMs": 101741,
        "text": "Aku menyanyikan entah berapa lagu dan menaburkan bunga-bunga"
      },
      {
        "atMs": 109817,
        "text": ""
      },
      {
        "atMs": 110948,
        "text": "Aku bagai mendengar suara tawamu di suatu tempat"
      },
      {
        "atMs": 117452,
        "text": "Sementara merasakan pipi yang hangat"
      },
      {
        "atMs": 121584,
        "text": "Jika aku terus maju di jalan memutar itu"
      },
      {
        "atMs": 126202,
        "text": "Maka mata ini pun akan terbuka"
      },
      {
        "atMs": 132467,
        "text": ""
      },
      {
        "atMs": 155815,
        "text": "Meski kita terpisah, waktu akan tetap datang"
      },
      {
        "atMs": 161693,
        "text": "Mari meneriakkan \"sekarang aku bahagia\""
      },
      {
        "atMs": 166585,
        "text": "Hal yang berharga tak dapat menjadi kata-kata"
      },
      {
        "atMs": 172130,
        "text": "Hilang di dalam cahaya yang memantul"
      },
      {
        "atMs": 176856,
        "text": "Seperti hujan bintang, aku ingin bertemu denganmu"
      },
      {
        "atMs": 183072,
        "text": "Aku takkan pernah melupakan waktu itu"
      },
      {
        "atMs": 187798,
        "text": "Hal yang berharga tak dapat menjadi kata-kata"
      },
      {
        "atMs": 193558,
        "text": "Segalanya yang terjadi di musim panas"
      },
      {
        "atMs": 198548,
        "text": ""
      },
      {
        "atMs": 199155,
        "text": "Cahaya yang tanpa diduga itu"
      },
      {
        "atMs": 204483,
