        "text": "Para kelinci pun melompat-lompat,"
      },
      {
        "atMs": 93610,
        "text": "gembira diiring gegap gempita."
      },
      {
        "atMs": 97014,
        "text": ""
      },
      {
        "atMs": 97614,
        "text": "Induknya pun menuntun sang anak,"
      },
      {
        "atMs": 101885,
        "text": "supaya tetap ada dalam genggamannya."
      },
      {
        "atMs": 104688,
        "text": ""
      },
      {
        "atMs": 105622,
        "text": "Harmoni ikut mengiringi,"
      },
      {
        "atMs": 109393,
        "text": "lantunan syair juga melodi."
      },
      {
        "atMs": 113497,
        "text": "Memoar pun mulai terpatri,"
      },
      {
        "atMs": 117601,
        "text": "tuk menyinari hati yang sepi."
      },
      {
        "atMs": 122439,
        "text": ""
      },
      {
        "atMs": 124108,
        "text": "Jiwa yang terjebak dalam dimensi penuh mimpi,"
      },
      {
        "atMs": 128112,
