  "3918b28e-49a9-5d8d-8d07-092833faf7c6": {
    "language": "id",
    "lines": [
      {
        "atMs": 20552,
        "text": "Kau berkata ingin dibiarkan sendiri"
      },
      {
        "atMs": 32329,
        "text": "Kau terus berusaha menjauh dariku"
      },
      {
        "atMs": 40792,
        "text": "Padahal sebenarnya, apa yang tersimpan di dalam hatimu"
      },
      {
        "atMs": 53476,
        "text": "Kau tak ingin orang lain melihatnya, bukan?"
      },
      {
        "atMs": 60809,
        "text": "Kemarahan, ketakutan, dan kesedihan"
      },
      {
        "atMs": 66957,
        "text": "Malam-malam dengan beban yang tak sanggup kau tanggung"
      },
      {
        "atMs": 72952,
        "text": "Namun, tak mampu kau ungkapkan lewat kata-kata"
      },
      {
        "atMs": 82385,
        "text": "Biarkan aku mendengarnya"
      },
      {
        "atMs": 88324,
        "text": "Suaramu yang berusaha kau sembunyikan"
      },
      {
        "atMs": 96187,
        "text": "Perlihatkanlah padaku"
      },
      {
        "atMs": 101585,
        "text": "Hatimu yang selalu berusaha kau sembunyikan"
      },
      {
        "atMs": 115419,
        "text": ""
      },
      {
        "atMs": 137208,
        "text": "Kau berkata bahwa kau bisa menjalani hidup seorang diri"
      },
      {
        "atMs": 149534,
        "text": "Kau terus meyakinkan dirimu akan hal itu"
      },
      {
        "atMs": 157182,
        "text": "Padahal sebenarnya, berkali-kali"
      },
      {
        "atMs": 164212,
        "text": "Kau mengulang-ulang kata itu kepada dirimu sendiri"
      },
      {
        "atMs": 170420,
        "text": "Ada malam-malam ketika kau harus meyakinkan dirimu demikian, bukan?"
      },
      {
        "atMs": 177584,
        "text": "Tapi tahukah kamu"
      },
      {
        "atMs": 179157,
        "text": "Dirimu, ya dirimu"
      },
      {
        "atMs": 184290,
        "text": "Seperti apa pun dirimu"
      },
      {
        "atMs": 189163,
        "text": "Aku ingin melihatnya"
      },
      {
        "atMs": 190801,
        "text": "Itulah yang selalu terlintas dalam pikiranku"
      },
      {
        "atMs": 200567,
        "text": ""
      },
      {
        "atMs": 202906,
        "text": "Biarkan aku mendengarnya"
      },
      {
        "atMs": 208249,
        "text": "Wajahmu yang berusaha kau sembunyikan"
      },
      {
        "atMs": 216137,
        "text": "Perlihatkanlah padaku"
      },
      {
        "atMs": 221449,
        "text": "Hatimu yang selalu kau sembunyikan"
      },
      {
        "atMs": 229185,
        "text": "Ceritakanlah kepadaku"
      },
      {
        "atMs": 234561,
        "text": "Apa pun yang ingin kau ceritakan, tak masalah dari mana kau memulainya. Aku akan mendengarkanmu sampai akhir"
      },
      {
        "atMs": 242871,
        "text": "Bukalah hatimu"
      },
      {
        "atMs": 248354,
        "text": "Aku ingin mendekat dan berada di sisi hatimu"
      },
      {
        "atMs": 266857,
        "text": ""
      }
    ],
    "videoId": "QBiCBkv2cLQ"
